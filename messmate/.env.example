# MessMate Database Configuration Placeholders
# Copy this file to .env or set as system environment variables before starting Apache Tomcat.
# NEVER commit real passwords or production secrets to version control.

MESSMATE_DB_URL=jdbc:mysql://localhost:3306/messmate_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC&characterEncoding=UTF-8
MESSMATE_DB_USER=messmate_app
MESSMATE_DB_PASSWORD=REPLACE_WITH_STRONG_DB_PASSWORD
MESSMATE_DB_POOL_SIZE=10
MESSMATE_SESSION_TIMEOUT_MINUTES=30
MESSMATE_LOW_RATING_THRESHOLD=3.0
